# =========================================================
# Backend — variables de entorno (cópialo a .env)
# Nunca subas este archivo al repositorio.
# =========================================================

# ─── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# ─── Base de datos PostgreSQL ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=completos_hosting
DB_USER=completos
DB_PASSWORD=

# ─── JWT (cámbialo por un secreto largo y aleatorio) ───────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
JWT_EXPIRES_IN=8h

# ─── Minecraft ─────────────────────────────────────────────
MC_SERVERS_DIR=/opt/completo-hosting/minecraft/servers
MC_JARS_DIR=/opt/completo-hosting/minecraft/jars
JAVA_EXECUTABLE=java
MINECRAFT_BASE_PORT=25565
# Puerto de arranque desde el que escanear puertos libres (usa MINECRAFT_BASE_PORT)

# ─── Red y Dominio (Cloudflare Tunnel + DNS SRV) ───────────
# Dominio raíz de los subdominios de Minecraft (FQDN: <sub>.MC_DOMAIN)
MC_DOMAIN=quesitohosting.shop

# Token API de Cloudflare (permisos: Zone.DNS edit + Tunnel/Zero Trust)
CLOUDFLARE_API_TOKEN=
# ID de la zona en Cloudflare para MC_DOMAIN
CLOUDFLARE_ZONE_ID=
# ID de la cuenta de Cloudflare (necesario para crear el Public Hostname
# TCP del túnel vía la API de Zero Trust). Obligatorio cuando el túnel se
# ejecuta en modo --token (remotely-managed).
CLOUDFLARE_ACCOUNT_ID=

# Túnel cloudflared (necesario si NO tienes IP pública):
#  - Nombre o UUID del túnel (obténlo con: cloudflared tunnel list)
CLOUDFLARE_TUNNEL=
# Ruta a config.yml del túnel (por defecto ~/.cloudflared/config.yml)
# CLOUDFLARE_TUNNEL_CONFIG=/root/.cloudflared/config.yml
# Si el túnel ya enruta el wildcard *.<MC_DOMAIN>, indícalo aquí (el backend
# no reescribirá config.yml y solo creará los registros DNS):
# CLOUDFLARE_TUNNEL_LOCAL_DOMAIN=1

# IP pública de respaldo (solo si NO usas túnel y el puerto está expuesto):
# PUBLIC_IP=203.0.113.10

# ─── Control de energía (Wake-on-LAN + apagado SO) ─────────
# Driver: wol | http | none
POWER_DRIVER=wol
POWER_WOL_MAC=AA:BB:CC:DD:EE:FF
POWER_WOL_BROADCAST=255.255.255.255
POWER_WOL_PORT=9
# Apagado del sistema operativo del host
POWER_OFF_COMMAND=systemctl poweroff

# (Opcional) Driver HTTP para dispositivos con API (ESP/Shelly/Tasmota)
# POWER_HTTP_ON_URL=http://192.168.1.50/on
# POWER_HTTP_OFF_URL=http://192.168.1.50/off
# POWER_HTTP_METHOD=GET
# POWER_HTTP_HEADERS={"Authorization":"Bearer xxxx"}
# POWER_HTTP_BODY={"state":true}
